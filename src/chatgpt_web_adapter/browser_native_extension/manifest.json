{
  "manifest_version": 3,
  "name": "ChatGPT Web Adapter",
  "version": "0.1.13",
  "description": "Connects the CWA local runtime to your existing ChatGPT browser session.",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": ["debugger", "tabs", "storage", "nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "service_worker_temporary_chat_route_reopen_probe.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "ChatGPT Web Adapter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
