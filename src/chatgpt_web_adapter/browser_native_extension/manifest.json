{
  "manifest_version": 3,
  "name": "ChatGPT Web Adapter Browser Native Bridge",
  "version": "0.1.10",
  "description": "Persistent background ChatGPT turn runtime for chatgpt-web-adapter.",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": ["debugger", "tabs", "storage", "nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "service_worker_temporary_chat_turn_probe.js"
  },
  "action": {
    "default_title": "ChatGPT Web Adapter bridge"
  }
}
